# Generated images and run outputs are local-only (see START_HERE rule 6)
runs/
poster_out/
__pycache__/
*.pyc

# Never commit credentials or tokens
.env
modal.toml
*.key

# Sample image files are not committed (only the descriptions in samples/SAMPLES.md)
samples/*.png
samples/*.jpg
samples/*.jpeg
samples/*.webp

# Secrets and certificates
.env.*
*.pem
*.p12
*.pfx
credentials.json
secrets/
